def _sequences_from_tensor(X):
    token_ids = torch.argmax(X, dim=-1).detach().cpu().numpy().T
    alphabet = list(string.ascii_lowercase[:X.shape[-1]])
    return np.array([''.join(alphabet[int(i)] for i in seq) for seq in token_ids])

    
